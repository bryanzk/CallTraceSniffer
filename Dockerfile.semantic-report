# Semantic Report FastAPI 服务（端口 9999）
FROM python:3.11-slim

WORKDIR /app

# 安装依赖（含 FastAPI/uvicorn，主应用依赖从 requirements.txt）
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir fastapi uvicorn

# 复制运行所需代码
COPY src/ ./src/
COPY scripts/ ./scripts/

# 输出目录（可挂载卷写入缓存）
RUN mkdir -p /app/outputs

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 9999

CMD ["uvicorn", "scripts.api.semantic_report_fastapi:app", "--host", "0.0.0.0", "--port", "9999"]
